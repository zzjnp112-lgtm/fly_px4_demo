<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_mid360'>
    <include merge='true'>
      <uri>x500</uri>
    </include>
    <include merge='true'>
      <uri>model://gemini2</uri>
      <pose relative_to="base_link">0 0 -0.11 0 1.5707 0</pose>
    </include>
    <joint name="gemini2_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
      <pose relative_to="base_link">0 0 -0.11 0 1.5707 0</pose>
    </joint>
    <link name="lidar_sensor_link">
      <pose relative_to="base_link">0 0 0.06 0 0 0</pose>
      <inertial>
        <mass>0.265</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <visual name="mid360_visual">
        <geometry>
          <cylinder>
            <radius>0.0465</radius>
            <length>0.041</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
      <sensor name='mid360_lidar' type='gpu_lidar'>
        <topic>/mid360/scan</topic>
        <gz_frame_id>lidar_sensor_link</gz_frame_id>
        <!-- 20Hz 对齐实机 MID-360(=20Hz); Point-LIO 每帧点云出一个 odom, 故 odom 也 20Hz。
             改此值须同步: launch 的 pcd2_to_livox scan_period_ns=50000000, pointlio_sim.yaml lidar_time_inte=0.05 -->
        <update_rate>20</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>24</samples>
              <resolution>1</resolution>
              <min_angle>-0.122</min_angle>
              <max_angle>0.907</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>40.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
      <sensor name='mid360_imu' type='imu'>
        <topic>/mid360/imu</topic>
        <gz_frame_id>lidar_sensor_link</gz_frame_id>
        <update_rate>200</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type='gaussian'>
                <mean>0.0</mean>
                <stddev>0.0002</stddev>
              </noise>
            </x>
            <y>
              <noise type='gaussian'>
                <mean>0.0</mean>
                <stddev>0.0002</stddev>
              </noise>
            </y>
            <z>
              <noise type='gaussian'>
                <mean>0.0</mean>
                <stddev>0.0002</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type='gaussian'>
                <mean>0.0</mean>
                <stddev>0.017</stddev>
              </noise>
            </x>
            <y>
              <noise type='gaussian'>
                <mean>0.0</mean>
                <stddev>0.017</stddev>
              </noise>
            </y>
            <z>
              <noise type='gaussian'>
                <mean>0.0</mean>
                <stddev>0.017</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
        <always_on>1</always_on>
      </sensor>
    </link>
    <joint name="lidar_sensor_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_sensor_link</child>
    </joint>

    <!-- 前视相机: 与正下方 gemini2 同规格(RGB 720p + 深度), 外壳缩小约一半。
         base_link +X 为机头方向; gz 相机默认光轴沿 +X, 故无需旋转即朝前。
         位置 x=0.18 使镜头略伸出机身前端(机身 collision 前缘 x≈0.177)。 -->
    <link name="front_camera_link">
      <pose relative_to="base_link">0.18 0 0 0 0 0</pose>
      <inertial>
        <mass>0.04</mass>
        <inertia>
          <ixx>0.000002667</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000009667</iyy>
          <iyz>0</iyz>
          <izz>0.000009667</izz>
        </inertia>
      </inertial>
      <visual name="front_camera_visual">
        <geometry>
          <box>
            <size>0.05 0.02 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <!-- 前视 RGB 镜头, 与下方 gemini2 同内参 (hfov=1.5016 => fx≈685.9 @1280x720) -->
      <sensor name="front_camera_rgb" type="camera">
        <gz_frame_id>front_camera_link</gz_frame_id>
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.5016</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>front_cam/rgb/image</topic>
      </sensor>
      <!-- 前视深度镜头, 与下方 gemini2 同规格 (1280x800, 量程 0.15-10m).
           2026-07-14 停用: 无人订阅但 always_on 每帧白渲染, 抢占 GPU 渲染线程导致相机
           stamp 落后画面内容(见 gemini2/model.sdf 同处注释). 需要时整块取消注释.
      <sensor name="front_camera_depth" type="depth_camera">
        <gz_frame_id>front_camera_link</gz_frame_id>
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.588</horizontal_fov>
          <image>
            <width>1280</width>
            <height>800</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.15</near>
            <far>10.0</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>front_cam/depth/image</topic>
      </sensor>
      -->

      <gravity>true</gravity>
      <velocity_decay />
    </link>
    <joint name="front_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>front_camera_link</child>
    </joint>
  </model>
</sdf>
