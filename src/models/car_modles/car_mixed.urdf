    </inertial>
  </link>
  <joint name="qr_code_joint" type="fixed">
    <parent link="deck1_link"/>
    <child link="qr_code_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.181"/>
  </joint>

  <!-- ============ 相机模组: 左右深度头(装饰) + 中央 RGB + 深度(depth_camera 仿真左右目合成的深度)
       话题对齐真机: /camera/color/image_raw、/camera/depth/image_raw ============ -->
  <link name="camera_mount_link">
    <visual>
      <!-- 立柱: 底盘顶面 -> 相机高度 -->
      <origin rpy="0 0 0" xyz="0 0 -0.03"/>
      <geometry>
        <cylinder length="0.06" radius="0.008"/>
      </geometry>
      <material name="pillar_color"/>
    </visual>
    <visual>
      <!-- 横杆: 左右各一个深度头(IR), 中间是 RGB -->
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.025 0.10 0.02"/>
      </geometry>
      <material name="pillar_color"/>
    </visual>
    <collision>
