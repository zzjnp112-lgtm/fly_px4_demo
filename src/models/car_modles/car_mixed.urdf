    </inertial>
  </link>
  <joint name="camera_ir_right_joint" type="fixed">
    <parent link="camera_mount_link"/>
    <child link="camera_ir_right_link"/>
    <origin rpy="0 0 0" xyz="0 -0.025 0"/>
  </joint>
  <!-- 中央 RGB 相机 link -->
  <link name="color_camera_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.03 0.02 0.02"/>
      </geometry>
      <material name="camera_color"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.03 0.02 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="color_camera_joint" type="fixed">
    <parent link="camera_mount_link"/>
    <child link="color_camera_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!-- color(RGB) + depth 两个传感器都挂在中央 color_camera_link，面朝 +x -->
  <gazebo reference="color_camera_link">
    <!-- RGB: 与真机 Gemini2 一致 1280x720@30, 16:9 FoV H86° -->
    <sensor name="color_camera" type="camera">
      <topic>/camera/color/image_raw</topic>
      <update_rate>30</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.50098</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>20.0</far>
        </clip>
      </camera>
    </sensor>
    <!-- depth: 仿真"左右深度头合成的深度图", 1280x800@30, FoV H91°, 范围 0.15~10m -->
    <sensor name="depth_camera" type="depth_camera">
      <topic>/camera/depth/image_raw</topic>
      <update_rate>30</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.58825</horizontal_fov>
        <image>
          <width>1280</width>
          <height>800</height>
        </image>
        <clip>
          <near>0.15</near>
          <far>10.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
  <!-- ============ Gazebo 控制插件 ============ -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.28</wheel_separation>
      <wheel_radius>0.0325</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <max_linear_acceleration>2.0</max_linear_acceleration>
      <min_linear_acceleration>-2.0</min_linear_acceleration>
      <max_angular_acceleration>4.0</max_angular_acceleration>
      <min_angular_acceleration>-4.0</min_angular_acceleration>
      <max_linear_velocity>0.5</max_linear_velocity>
      <min_linear_velocity>-0.5</min_linear_velocity>
      <max_angular_velocity>0.6</max_angular_velocity>
      <min_angular_velocity>-0.6</min_angular_velocity>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>
</robot>
