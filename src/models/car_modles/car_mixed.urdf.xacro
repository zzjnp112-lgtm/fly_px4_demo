<?xml version="1.0"?>
<robot name="car_mixed" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- 仿真启动从共享 speed_limits.yaml 传入，单独显示模型时使用同值默认。 -->
  <xacro:arg name="max_linear" default="0.5"/>
  <xacro:arg name="max_angular" default="0.6"/>
  <!-- 仿真相机开关: spawn.launch.py 联动 use_camera 参数传入。
       false=只保留 gpu_lidar(纯雷达探索足够, 省 CPU/GPU 渲染);
       true=保留 RGB + depth 相机, 需要视觉/深度话题时开。 -->
  <xacro:arg name="sim_camera" default="true"/>
  <xacro:property name="sim_camera" value="${'$(arg sim_camera)' == 'true'}"/>
  <xacro:property name="speed_limit_linear" value="${float('$(arg max_linear)')}"/>
  <xacro:property name="speed_limit_angular" value="${float('$(arg max_angular)')}"/>

  <!-- ================================================================
       可调参数区（改车型尺寸主要改这里，下方全部尺寸由这些参数推导）
       改完执行 colcon build（symlink install）后重新 spawn 生效
       注意: wheel_radius 改动后需同步改 car_control/launch/spawn.launch.py
             中 MODEL_SPAWN_Z['car_mixed']（= 驱动轮半径）
       ================================================================ -->
  <!-- 底盘: 平板箱体, base_link 原点位于地面 -->
  <xacro:property name="chassis_length" value="0.35"/>
  <xacro:property name="chassis_width" value="0.25"/>
  <xacro:property name="chassis_height" value="0.04"/>
  <xacro:property name="chassis_bottom" value="0.055"/>
  <xacro:property name="chassis_mass" value="2.5"/>

  <!-- 驱动轮(差速两轮): 轮心高度自动 = wheel_radius, x 位置 wheel_x(负值=靠车尾) -->
  <xacro:property name="wheel_radius" value="0.0325"/>   <!-- 直径 65mm -->
  <xacro:property name="wheel_width" value="0.025"/>
  <xacro:property name="wheel_mass" value="0.3"/>
  <xacro:property name="wheel_separation" value="0.28"/>
  <xacro:property name="wheel_x" value="-0.07"/>

  <!-- 前万向轮(支撑球, 摩擦0): caster_sink = 球体预压下沉量,
       让球比驱动轮着地点略低 ~2mm, 保证仿真中始终接触地面(防撞墙翘头/悬空) -->
  <xacro:property name="caster_radius" value="0.025"/>
  <xacro:property name="caster_mass" value="0.1"/>
  <xacro:property name="caster_x" value="0.13"/>
  <xacro:property name="caster_sink" value="0.002"/>

  <!-- 单层平台结构 -->
  <xacro:property name="deck_length" value="0.20"/>
  <xacro:property name="deck_width" value="0.16"/>
  <xacro:property name="deck_thickness" value="0.02"/>
  <xacro:property name="deck_mass" value="0.2"/>
  <xacro:property name="deck1_z" value="0.17"/>
  <xacro:property name="pillar_radius" value="0.008"/>
  <xacro:property name="pillar_x" value="0.08"/>
  <xacro:property name="pillar_y" value="0.06"/>

  <!-- Livox Mid-360 (官方规格, 2026-09-07 核实): 65x65x60mm/265g, FOV 360°x59°(-7°~52°),
       量程 0.1m~40m@10%反射(70m@80%), 20万点/s; 实机配置 20Hz(2026-09-16 用户确认), 仿真对齐 -->
  <xacro:property name="lidar_radius" value="0.0325"/>
  <xacro:property name="lidar_height" value="0.060"/>
  <xacro:property name="lidar_mass" value="0.265"/>
  <xacro:property name="lidar_fov_min" value="-0.1222"/>
  <xacro:property name="lidar_fov_max" value="0.9076"/>
  <!-- gpu_lidar 垂直均匀采样，18 层时有一束约 -0.06°，接近水平。 -->

  <!-- Orbbec Gemini 2 (官方规格): 双目基线50mm; 深度 1280x800@30, FoV H91°xV66°, 0.15~10m;
       RGB 1280x720@30(16:9), FoV H86°xV55° -->
  <xacro:property name="cam_baseline" value="0.050"/>
  <!-- RGB 彩色相机 -->
  <xacro:property name="color_hfov" value="1.50098"/>   <!-- 86° -->
  <xacro:property name="color_width" value="1280"/>
  <xacro:property name="color_height" value="720"/>
  <xacro:property name="color_fps" value="30"/>
  <!-- 深度相机 -->
  <xacro:property name="depth_hfov" value="1.58825"/>   <!-- 91° -->
  <xacro:property name="depth_width" value="1280"/>
  <xacro:property name="depth_height" value="800"/>
  <xacro:property name="depth_fps" value="30"/>
  <xacro:property name="cam_mount_x" value="0.17"/>
  <xacro:property name="cam_mount_z" value="0.155"/>

  <material name="chassis_color">
    <color rgba="0.2 0.4 0.8 1"/>
  </material>
  <material name="deck_color">
    <color rgba="0.15 0.3 0.6 1"/>
  </material>
  <material name="pillar_color">
    <color rgba="0.4 0.4 0.4 1"/>
  </material>
  <material name="wheel_color">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>
  <material name="lidar_color">
    <color rgba="0.05 0.05 0.05 1"/>
  </material>
  <material name="camera_color">
    <color rgba="0.8 0.1 0.1 1"/>
  </material>

  <!-- base_link: 底盘平板, 原点位于地面 -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_bottom + chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="chassis_color"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_bottom + chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.02 0 ${chassis_bottom + chassis_height/2}"/>
      <mass value="${chassis_mass}"/>
      <inertia
        ixx="${chassis_mass/12*(chassis_width*chassis_width+chassis_height*chassis_height)}" ixy="0" ixz="0"
        iyy="${chassis_mass/12*(chassis_length*chassis_length+chassis_height*chassis_height)}" iyz="0"
        izz="${chassis_mass/12*(chassis_length*chassis_length+chassis_width*chassis_width)}"/>
    </inertial>
  </link>

  <!-- ============ 驱动轮 ============ -->
  <xacro:macro name="wheel" params="prefix reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_color"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${wheel_mass/12*(3*wheel_radius*wheel_radius+wheel_width*wheel_width)}" ixy="0" ixz="0"
          iyy="${wheel_mass/2*wheel_radius*wheel_radius}" iyz="0"
          izz="${wheel_mass/12*(3*wheel_radius*wheel_radius+wheel_width*wheel_width)}"/>
      </inertial>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${wheel_x} ${reflect * wheel_separation/2} ${wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left" reflect="1"/>
  <xacro:wheel prefix="right" reflect="-1"/>

  <!-- ============ 前万向轮 ============ -->
  <link name="caster_link">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="wheel_color"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${caster_mass}"/>
      <inertia ixx="${2/5*caster_mass*caster_radius*caster_radius}" ixy="0" ixz="0"
        iyy="${2/5*caster_mass*caster_radius*caster_radius}" iyz="0"
        izz="${2/5*caster_mass*caster_radius*caster_radius}"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <!-- z 比 caster_radius 低 caster_sink: 球体预压进地面, 保证三点支撑始终接触 -->
    <origin xyz="${caster_x} 0 ${caster_radius - caster_sink}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="caster_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- ============ 单层平台 + 支撑柱 ============ -->
  <xacro:macro name="pillar" params="x y z1 z2">
    <visual>
      <origin xyz="${x} ${y} ${(z1+z2)/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${pillar_radius}" length="${z2-z1}"/>
      </geometry>
      <material name="pillar_color"/>
    </visual>
    <collision>
      <origin xyz="${x} ${y} ${(z1+z2)/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${pillar_radius}" length="${z2-z1}"/>
      </geometry>
    </collision>
  </xacro:macro>

  <link name="deck1_link">
    <visual>
      <origin xyz="0 0 ${deck1_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${deck_length} ${deck_width} ${deck_thickness}"/>
      </geometry>
      <material name="deck_color"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${deck1_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${deck_length} ${deck_width} ${deck_thickness}"/>
      </geometry>
    </collision>
    <!-- 下层4根支撑柱: 底盘顶面 -> deck1 底面 -->
    <xacro:pillar x="${pillar_x}" y="${pillar_y}" z1="${chassis_bottom + chassis_height}" z2="${deck1_z - deck_thickness/2}"/>
    <xacro:pillar x="${pillar_x}" y="${-pillar_y}" z1="${chassis_bottom + chassis_height}" z2="${deck1_z - deck_thickness/2}"/>
    <xacro:pillar x="${-pillar_x}" y="${pillar_y}" z1="${chassis_bottom + chassis_height}" z2="${deck1_z - deck_thickness/2}"/>
    <xacro:pillar x="${-pillar_x}" y="${-pillar_y}" z1="${chassis_bottom + chassis_height}" z2="${deck1_z - deck_thickness/2}"/>
    <inertial>
      <origin xyz="0 0 ${deck1_z}"/>
      <mass value="${deck_mass}"/>
      <inertia
        ixx="${deck_mass/12*(deck_width*deck_width+deck_thickness*deck_thickness)}" ixy="0" ixz="0"
        iyy="${deck_mass/12*(deck_length*deck_length+deck_thickness*deck_thickness)}" iyz="0"
        izz="${deck_mass/12*(deck_length*deck_length+deck_width*deck_width)}"/>
    </inertial>
  </link>

  <joint name="deck1_joint" type="fixed">
    <parent link="base_link"/>
    <child link="deck1_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ============ Livox Mid-360 3D激光雷达: 平台顶面中央 ============ -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="lidar_color"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${lidar_mass}"/>
      <inertia
        ixx="${lidar_mass/12*(3*lidar_radius*lidar_radius+lidar_height*lidar_height)}" ixy="0" ixz="0"
        iyy="${lidar_mass/12*(3*lidar_radius*lidar_radius+lidar_height*lidar_height)}" iyz="0"
        izz="${lidar_mass/2*lidar_radius*lidar_radius}"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="deck1_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${deck1_z + deck_thickness/2 + lidar_height/2}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/scan</topic>
      <update_rate>20</update_rate>   <!-- 实机 Mid-360 配置 20Hz -->
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <!-- 720 线(0.5°) x 18 层 x 20Hz ≈ 26万点/s -->
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <!-- Mid-360 垂直FOV: -7deg ~ +52deg -->
          <vertical>
            <samples>18</samples>
            <resolution>1</resolution>
            <min_angle>${lidar_fov_min}</min_angle>
            <max_angle>${lidar_fov_max}</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.1</min>
          <max>40.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>

  </gazebo>

  <!-- ============ 相机模组: 左右深度头(装饰) + 中央 RGB + 深度(depth_camera 仿真左右目合成的深度)
       话题对齐真机: /camera/color/image_raw、/camera/depth/image_raw ============ -->
  <link name="camera_mount_link">
    <visual>
      <!-- 立柱: 底盘顶面 -> 相机高度 -->
      <origin xyz="0 0 ${-0.06/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.06"/>
      </geometry>
      <material name="pillar_color"/>
    </visual>
    <visual>
      <!-- 横杆: 左右各一个深度头(IR), 中间是 RGB -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.10 0.02"/>
      </geometry>
      <material name="pillar_color"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${-0.06/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.06"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.10 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.01"/>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="camera_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_mount_link"/>
    <origin xyz="${cam_mount_x} 0 ${cam_mount_z}" rpy="0 0 0"/>
  </joint>

  <!-- 左右深度头: 仅视觉外观(基线=双目基线), 不产生话题; 深度统一由中央 depth_camera 传感器合成 -->
  <xacro:macro name="ir_head" params="prefix reflect">
    <link name="camera_ir_${prefix}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.03 0.02 0.02"/>
        </geometry>
        <material name="lidar_color"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.03 0.02 0.02"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.02"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
    </link>
    <joint name="camera_ir_${prefix}_joint" type="fixed">
      <parent link="camera_mount_link"/>
      <child link="camera_ir_${prefix}_link"/>
      <origin xyz="0 ${reflect * cam_baseline/2} 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:ir_head prefix="left" reflect="1"/>
  <xacro:ir_head prefix="right" reflect="-1"/>

  <!-- 中央 RGB 相机 link -->
  <link name="color_camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.02 0.02"/>
      </geometry>
      <material name="camera_color"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.02 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="color_camera_joint" type="fixed">
    <parent link="camera_mount_link"/>
    <child link="color_camera_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- color(RGB) + depth 两个传感器都挂在中央 color_camera_link，面朝 +x -->
  <gazebo reference="color_camera_link">
    <xacro:if value="${sim_camera}">
    <!-- RGB: 与真机 Gemini2 一致 1280x720@30, 16:9 FoV H86° -->
    <sensor name="color_camera" type="camera">
      <topic>/camera/color/image_raw</topic>
      <update_rate>${color_fps}</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>${color_hfov}</horizontal_fov>
        <image>
          <width>${color_width}</width>
          <height>${color_height}</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>20.0</far>
        </clip>
      </camera>
    </sensor>

    <!-- depth: 仿真"左右深度头合成的深度图", 1280x800@30, FoV H91°, 范围 0.15~10m -->
    <sensor name="depth_camera" type="depth_camera">
      <topic>/camera/depth/image_raw</topic>
      <update_rate>${depth_fps}</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>${depth_hfov}</horizontal_fov>
        <image>
          <width>${depth_width}</width>
          <height>${depth_height}</height>
        </image>
        <clip>
          <near>0.15</near>
          <far>10.0</far>
        </clip>
      </camera>
    </sensor>
    </xacro:if>
  </gazebo>

  <!-- ============ Gazebo 控制插件 ============ -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <max_linear_acceleration>2.0</max_linear_acceleration>
      <min_linear_acceleration>-2.0</min_linear_acceleration>
      <max_angular_acceleration>4.0</max_angular_acceleration>
      <min_angular_acceleration>-4.0</min_angular_acceleration>
      <max_linear_velocity>${speed_limit_linear}</max_linear_velocity>
      <min_linear_velocity>${-speed_limit_linear}</min_linear_velocity>
      <max_angular_velocity>${speed_limit_angular}</max_angular_velocity>
      <min_angular_velocity>${-speed_limit_angular}</min_angular_velocity>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

</robot>
